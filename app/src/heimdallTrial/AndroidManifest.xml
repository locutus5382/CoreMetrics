<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- The standalone trial MUST NOT launch the old CoreMetrics UI or
             expose its legacy Quick Settings START/ARM recording commands. -->
        <activity android:name=".ui.MainActivity"
            android:exported="false"
            tools:node="replace" />
        <activity android:name=".trial.HeimdallTrialActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".quick.HudTile" tools:node="remove"/>
        <service android:name=".quick.SessionTile" tools:node="remove"/>
    </application>
</manifest>
